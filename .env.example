# ===== NoneBot 基础 =====
# 环境：prod（正式）/ dev（开发，会加载 .env.dev 的 DEBUG 日志）
ENVIRONMENT=prod
LOG_LEVEL=INFO

# 驱动：需要 websockets（OneBot WS 用）
DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080

# ===== OneBot 协议端（NapCat / SnowLuma 等）=====
# 与协议端约定的访问令牌（两端要一致）
ONEBOT_ACCESS_TOKEN=请改成你自己的随机字符串
# 正向 WS：NoneBot 主动连接协议端（SnowLuma 默认 /onebot/v11/ws）
ONE_BOT_WS_URL=ws://127.0.0.1:3001/onebot/v11/ws

# ===== Berry Melody 插件 =====
# 允许使用 /bmaddname /bmremovename 的 QQ 白名单
BM_ADMIN_QQS=[1234567890]
# 超管 QQ：唯一可管理白名单（/bmaddtowhitelist 等）
BM_SUPER_ADMIN_QQ=1234567890
